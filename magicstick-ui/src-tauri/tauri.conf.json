{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magicstick-ui",
  "version": "3.2.0",
  "identifier": "com.example.magicstick-ui",
  "build": {
    "beforeDevCommand": "dotnet build src-dotnet/MagicStickUI.Backend && npm run dev",
    "beforeBuildCommand": "dotnet build src-dotnet/MagicStickUI.Backend -c Release -o src-tauri/backend && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MagicStick",
        "width": 900,
        "height": 700,
        "minWidth": 900,
        "minHeight": 700,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "backend/": "dotnet/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
