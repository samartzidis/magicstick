<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    tauri-plugin-dotnet is not on nuget.org; this feed is just the artifacts\ folder of the sibling
    tauri-plugin-dotnet checkout, where `dotnet pack` writes Tauri.Plugin.DotNet.<version>.nupkg. No
    <clear/> here, so nuget.org and any machine/user-level sources still apply for every other package.
  -->
  <packageSources>
    <add key="tauri-plugin-dotnet-local" value="..\..\..\tauri-plugin-dotnet\artifacts" />
  </packageSources>
</configuration>
